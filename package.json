    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "stripe": "^16.9.0"
  },
  "devDependencies": {
    "sqlite3": "^5.1.7",
    "sequelize-cli": "^6.6.2",
    "jest": "^29.7.0",
