  "description": "API back-end UNIVERS PLUS — authentification JWT, catalogue, panier, commandes et paiements",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
