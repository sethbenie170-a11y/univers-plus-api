PORT=4000
NODE_ENV=development

# ---- Base de données ----
# En production : DB_DIALECT=postgres (recommandé)
# Pour un test rapide en local sans installer PostgreSQL : DB_DIALECT=sqlite
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=univers_plus
DB_USER=postgres
DB_PASSWORD=changeme

# Utilisé uniquement si DB_DIALECT=sqlite
DB_STORAGE=./data/dev.sqlite

# ---- JWT ----
# Générez des secrets forts en production, par exemple avec :
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---- CORS ----
CORS_ORIGIN=http://localhost:3000

# ---- Paiements ----
# Devise utilisée pour les commandes et Stripe (le FCFA/XOF est une devise "zéro décimale").
PAYMENT_CURRENCY=xof
FRONTEND_URL=http://localhost:3000

# Stripe (mode test) — récupérez ces clés depuis le Dashboard Stripe, section "Développeurs".
STRIPE_SECRET_KEY=sk_test_votre_cle_secrete
STRIPE_WEBHOOK_SECRET=whsec_votre_secret_webhook

# PayPal (sandbox) — créez une app sur developer.paypal.com pour obtenir ces identifiants.
# PayPal ne prend pas en charge le FCFA : les montants sont convertis avec un taux fixe
# de démonstration (PAYPAL_XOF_TO_USD_RATE), à remplacer par un vrai taux de change en production.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=votre_client_id_paypal
PAYPAL_CLIENT_SECRET=votre_client_secret_paypal
PAYPAL_CURRENCY=USD
PAYPAL_XOF_TO_USD_RATE=0.0017
